SQLSERVER_HOST=<your_sql_server.database.windows.net>
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=<your_database_name>
SQLSERVER_USERNAME=<your_username>
SQLSERVER_PASSWORD=<your_password>

SNOWFLAKE_HOST=<your_snowflake_account>.snowflakecomputing.com
SNOWFLAKE_DATABASE=<your_snowflake_database_name>
SNOWFLAKE_SCHEMA=<your_snowflake_schema_name>
SNOWFLAKE_WAREHOUSE=<your_snowflake_warehouse_name>
SNOWFLAKE_ROLE=<your_snowflake_role_name>
SNOWFLAKE_USERNAME=<your_snowflake_username>

PRIVATE_KEY_FILE=<your_private_key_file>.pem
PRIVATE_KEY_PASSWORD=<your_private_key_password>